# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
# Local: localhost,127.0.0.1   Live: add the backend domain, e.g. your-api.vercel.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend address(es) allowed to call the API, comma separated. Live: the https frontend URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# PostgreSQL connection string. Hosted databases usually need ?sslmode=require
DATABASE_URL=postgres://postgres:your-password@localhost:5432/mns_db

# Secret typed in the "Forgot password?" pop-up on the login page. Empty switches that feature off.
PASSWORD_RESET_KEY=

# Optional: shared cache so request limits work across servers (e.g. redis://localhost:6379/0)
# REDIS_URL=
# Optional: wrong sign-in attempts before a lock, and the lock length in seconds
# LOGIN_MAX_ATTEMPTS=3
# LOGIN_LOCK_SECONDS=300
